---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const pages = (await getCollection('pages', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<Base title="ddtl.press">
  <h1>Interactive explainers</h1>
  <ul class="list">
    {pages.map((p) => (
      <li>
        <a href={`/${p.id}/`}>{p.data.title}</a>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .list { list-style: none; padding: 0; }
  .list li { padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .list a { font-weight: 600; font-size: 1.1rem; }
  .list p { margin: 0.25rem 0 0; color: var(--muted); }
</style>
