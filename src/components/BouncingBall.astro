---
// Minimal example simulation: a ball under gravity with a restitution slider.
// Vanilla canvas + a custom element, so it ships only a few hundred bytes of JS
// and only on pages that use it.
interface Props {
  height?: number;
}
const { height = 260 } = Astro.props;
---
<bouncing-ball data-height={height}>
  <canvas aria-label="A ball bouncing under gravity"></canvas>
  <label class="control">
    Bounciness <input type="range" min="0.3" max="0.95" step="0.05" value="0.8" />
  </label>
</bouncing-ball>

<style>
  bouncing-ball { display: block; }
  canvas { display: block; width: 100%; }
  .control { display: flex; gap: 0.75rem; align-items: center; padding: 10px 14px; border-top: 1px solid var(--border); font-size: 0.9rem; color: var(--muted); }
  input { flex: 1; accent-color: var(--accent); }
</style>

<script>
  class BouncingBall extends HTMLElement {
    connectedCallback() {
      const canvas = this.querySelector('canvas')!;
      const slider = this.querySelector('input')!;
      const ctx = canvas.getContext('2d')!;
      const h = Number(this.dataset.height ?? 260);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const r = 14;
      let y = r, vy = 0, x = 0, last = performance.now();

      const resize = () => {
        const dpr = devicePixelRatio || 1;
        canvas.width = canvas.clientWidth * dpr;
        canvas.height = h * dpr;
        canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        x = canvas.clientWidth / 2;
      };
      resize();
      new ResizeObserver(resize).observe(canvas);

      const accent = () => getComputedStyle(this).getPropertyValue('--accent').trim() || '#2f6fdb';

      const draw = () => {
        ctx.clearRect(0, 0, canvas.clientWidth, h);
        ctx.fillStyle = accent();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
      };

      const step = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.033);
        last = now;
        vy += 1400 * dt;
        y += vy * dt;
        if (y > h - r) {
          y = h - r;
          vy = -vy * Number(slider.value);
          if (Math.abs(vy) < 60) vy = -900; // keep it going
        }
        draw();
        requestAnimationFrame(step);
      };

      if (reduce) { y = h - r; draw(); } else requestAnimationFrame(step);
    }
  }
  customElements.define('bouncing-ball', BouncingBall);
</script>
